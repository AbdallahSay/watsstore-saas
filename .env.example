# ==========================================
# WatsStore SaaS - Environment Configuration
# ==========================================

# PostgreSQL Credentials
POSTGRES_DB=watsstoredb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_generate_a_strong_random_password

# Backend JWT Configuration
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_generate_a_random_64plus_character_secret

# Public API URL for Frontend (Set to your VPS IP or Domain, e.g. https://api.yourdomain.com or http://<VPS_IP>:5000)
NEXT_PUBLIC_API_URL=http://localhost:5000
